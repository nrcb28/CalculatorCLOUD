{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloudCost Compare",
  "version": "0.1.0",
  "identifier": "io.cloudcost.compare",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CloudCost Compare",
        "width": 1360,
        "height": 900,
        "minWidth": 880,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}